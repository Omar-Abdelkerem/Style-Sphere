@page
@model StyleSphere.Pages.AddReviewModel
@{
    ViewData["Title"] = "Customer Review - StyleSphere";
    Layout = "_CustomerLayout";
    var product = ViewData["Product"] as StyleSphere.Models.Product;
}

<div class="container py-5">
    <div style="max-width: 520px; margin: 30px auto;">
        <div class="clean-card">
            <h1 class="h4 fw-bold text-center mb-1 text-uppercase letter-spacing-1">Product Review</h1>
            <p class="text-secondary small text-center mb-4">Sharing feedback for <strong>@product?.Name</strong></p>

            @if (!string.IsNullOrEmpty((string?)TempData["ErrorMessage"]))
            {
                <div class="alert alert-danger rounded-0 py-2 px-3 small mb-3" role="alert">
                    @TempData["ErrorMessage"]
                </div>
            }

            <form method="post">
                <input type="hidden" name="productId" value="@product?.ProductID" />
                
                <div class="mb-3">
                    <label for="rating" class="form-label">Score (1 to 5)</label>
                    <select name="rating" id="rating" class="form-select rounded-0" required>
                        <option value="5" selected>5 - Excellent Quality</option>
                        <option value="4">4 - Very Good</option>
                        <option value="3">3 - Satisfactory</option>
                        <option value="2">2 - Below Expectations</option>
                        <option value="1">1 - Poor</option>
                    </select>
                </div>

                <div class="mb-4">
                    <label for="comment" class="form-label">Written Feedback (Optional)</label>
                    <textarea name="comment" id="comment" rows="4" class="form-control rounded-0" 
                              placeholder="Provide details about fit, texture, and durability..."></textarea>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-solid flex-grow-1 py-3">
                        Submit Review
                    </button>
                    <a asp-page="/details" asp-route-id="@product?.ProductID" class="btn btn-outline-minimal py-3 px-4">
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>
