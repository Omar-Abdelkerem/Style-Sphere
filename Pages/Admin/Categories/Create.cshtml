@page
@model StyleSphere.Pages.Admin.Categories.CreateModel
@{
    ViewData["Title"] = "Create Category";
}

<div class="py-2" style="max-width: 700px; margin: 0 auto;">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 small">
                    <li class="breadcrumb-item"><a asp-page="/Admin/Index" class="text-decoration-none">Admin</a></li>
                    <li class="breadcrumb-item"><a asp-page="Index" class="text-decoration-none">Categories</a></li>
                    <li class="breadcrumb-item active" aria-current="page">New Category</li>
                </ol>
            </nav>
            <h1 class="h2 fw-bold mb-0">Create New Department</h1>
        </div>
        <a asp-page="Index" class="btn btn-outline-secondary rounded-pill px-3 py-2 btn-sm fw-semibold">
            <i class="bi bi-arrow-left me-1"></i> Back
        </a>
    </div>

    @if (ViewData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger rounded-4 p-3 mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @ViewData["ErrorMessage"]
        </div>
    }

    <div class="card border-0 rounded-4 shadow-sm p-4 p-md-5">
        <form method="post">
            <div class="mb-3">
                <label for="name" class="form-label small fw-bold text-muted">Category Title <span class="text-danger">*</span></label>
                <input type="text" name="name" id="name" class="form-control rounded-pill px-3 shadow-none" placeholder="e.g. Designer Handbags" required />
            </div>

            <div class="mb-4">
                <label for="description" class="form-label small fw-bold text-muted">Description (Optional)</label>
                <textarea name="description" id="description" rows="3" class="form-control rounded-4 shadow-none px-3" placeholder="Summary of products belonging to this category..."></textarea>
            </div>

            <div class="d-flex gap-2 pt-2 border-top">
                <button type="submit" class="btn btn-primary-custom rounded-pill px-4 py-2 fw-semibold">
                    <i class="bi bi-check-lg me-1"></i> Create Category
                </button>
                <a asp-page="Index" class="btn btn-outline-secondary rounded-pill px-4 py-2 fw-semibold">
                    Cancel
                </a>
            </div>
        </form>
    </div>
</div>
