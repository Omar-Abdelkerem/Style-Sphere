@page
@model StyleSphere.Pages.Admin.Categories.CreateModel
@{
    ViewData["Title"] = "Create Category";
}

<div class="py-2" style="max-width: 700px; margin: 0 auto;">
    <div class="d-flex justify-content-between align-items-baseline mb-4 pb-2 border-bottom">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 small">
                    <li class="breadcrumb-item"><a asp-page="/Admin/Index" class="text-secondary">Admin</a></li>
                    <li class="breadcrumb-item"><a asp-page="Index" class="text-secondary">Categories</a></li>
                    <li class="breadcrumb-item active text-dark" aria-current="page">New Category</li>
                </ol>
            </nav>
            <h1 class="h3 fw-bold mb-0 text-uppercase letter-spacing-1">Create New Department</h1>
        </div>
        <a asp-page="Index" class="btn btn-sm btn-outline-minimal">
            &larr; Back
        </a>
    </div>

    @if (ViewData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger rounded-0 py-2 px-3 small mb-4" role="alert">
            @ViewData["ErrorMessage"]
        </div>
    }

    <div class="clean-card">
        <form method="post">
            <div class="mb-3">
                <label for="name" class="form-label">Category Title <span class="text-danger">*</span></label>
                <input type="text" name="name" id="name" class="form-control" placeholder="e.g. Designer Handbags" maxlength="100" required />
            </div>

            <div class="mb-4">
                <label for="description" class="form-label">Description (Optional)</label>
                <textarea name="description" id="description" rows="3" class="form-control" maxlength="500" placeholder="Summary of products belonging to this category..."></textarea>
            </div>

            <div class="d-flex gap-2 pt-3 border-top">
                <button type="submit" class="btn btn-solid">
                    Create Category
                </button>
                <a asp-page="Index" class="btn btn-outline-minimal">
                    Cancel
                </a>
            </div>
        </form>
    </div>
</div>
