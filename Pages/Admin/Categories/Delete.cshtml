@page "{id:int}"
@model StyleSphere.Pages.Admin.Categories.DeleteModel
@{
    ViewData["Title"] = "Delete Category";
    
    // Get category from ViewData (set in the .cs file)
    var category = ViewData["Category"] as StyleSphere.Models.Category;
}

<div style="max-width: 800px; margin: 0 auto; padding: 20px;">
    <h1>Delete Category</h1>
    <hr />

    @if (category != null)
    {
        <h3>Are you sure you want to delete this category?</h3>
        
        @* Display category information *@
        <div>
            <table border="1" cellpadding="10" cellspacing="0" style="width: 100%; border-collapse: collapse; margin: 20px 0;">
                <tr>
                    <th style="background-color: #f0f0f0;">Category ID:</th>
                    <td>@category.CategoryID</td>
                </tr>
                <tr>
                    <th style="background-color: #f0f0f0;">Name:</th>
                    <td>@category.Name</td>
                </tr>
                <tr>
                    <th style="background-color: #f0f0f0;">Description:</th>
                    <td>
                        @if (!string.IsNullOrEmpty(category.Description))
                        {
                            @category.Description
                        }
                        else
                        {
                            <text>N/A</text>
                        }
                    </td>
                </tr>
                <tr>
                    <th style="background-color: #f0f0f0;">Products Count:</th>
                    <td>
                        @if (category.Products != null)
                        {
                            @category.Products.Count
                        }
                        else
                        {
                            <text>0</text>
                        }
                    </td>
                </tr>
            </table>

            @* Show warning if category has products *@
            @if (category.Products != null && category.Products.Count > 0)
            {
                <div style="background-color: #fff3cd; color: #856404; padding: 15px; margin: 10px 0; border: 1px solid #ffeaa7; border-radius: 4px;">
                    <strong>Warning!</strong> This category has @category.Products.Count product(s). Deleting this category may affect those products.
                </div>
            }

            @* Delete form *@
            @* When submitted, it will call OnPost method with id *@
            <form method="post">
                <input type="hidden" name="id" value="@category.CategoryID" />
                <button type="submit" style="padding: 10px 20px; background-color: #dc3545; color: white; border: none; border-radius: 4px; cursor: pointer; margin-right: 10px;">Delete</button>
                <a asp-page="Index" style="padding: 10px 20px; background-color: #6c757d; color: white; text-decoration: none; border-radius: 4px; display: inline-block;">Cancel</a>
            </form>
        </div>
    }
</div>

