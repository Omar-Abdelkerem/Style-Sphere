@page "{id:int}"
@model StyleSphere.Pages.Admin.Categories.DeleteModel
@{
    ViewData["Title"] = "Delete Category";
    var category = ViewData["Category"] as StyleSphere.Models.Category;
}

<div class="py-2" style="max-width: 700px; margin: 0 auto;">
    <div class="d-flex justify-content-between align-items-baseline mb-4 pb-2 border-bottom">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 small">
                    <li class="breadcrumb-item"><a asp-page="/Admin/Index" class="text-secondary">Admin</a></li>
                    <li class="breadcrumb-item"><a asp-page="Index" class="text-secondary">Categories</a></li>
                    <li class="breadcrumb-item active text-dark" aria-current="page">Delete Category</li>
                </ol>
            </nav>
            <h1 class="h3 fw-bold mb-0 text-uppercase letter-spacing-1 text-danger">Remove Category</h1>
        </div>
        <a asp-page="Index" class="btn btn-sm btn-outline-minimal">
            &larr; Cancel
        </a>
    </div>

    @if (category != null)
    {
        <div class="clean-card">
            <div class="alert alert-danger rounded-0 p-3 mb-4">
                <h2 class="h6 fw-bold mb-1 text-uppercase">Confirm Permanent Deletion</h2>
                <p class="small mb-0">Are you sure you want to remove <strong>@category.Name</strong>?</p>
            </div>

            <div class="p-3 bg-light mb-4 border">
                <div class="fw-bold mb-1">@category.Name</div>
                <div class="text-secondary small mb-2">@(!string.IsNullOrEmpty(category.Description) ? category.Description : "No description")</div>
                <div class="small">
                    Assigned Catalog Items: <span class="badge bg-white text-dark border rounded-0">@(category.Products?.Count ?? 0) products</span>
                </div>
            </div>

            <form method="post" class="d-flex gap-2">
                <input type="hidden" name="id" value="@category.CategoryID" />
                <button type="submit" class="btn btn-danger rounded-0 px-4 py-2 text-uppercase small fw-bold">
                    Delete Category
                </button>
                <a asp-page="Index" class="btn btn-outline-minimal">
                    Cancel
                </a>
            </form>
        </div>
    }
</div>
