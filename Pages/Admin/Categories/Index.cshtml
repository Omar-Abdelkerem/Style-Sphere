@page
@model StyleSphere.Pages.Admin.Categories.IndexModel
@{
    ViewData["Title"] = "Categories Management";
    
    // Get data from ViewData (set in the .cs file)
    var categories = ViewData["Categories"] as List<StyleSphere.Models.Category>;
    var productCounts = ViewData["ProductCounts"] as Dictionary<int, int>;
}

<div style="max-width: 1200px; margin: 0 auto; padding: 20px;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
        <h1>Categories Management</h1>
        <a asp-page="Create" style="padding: 10px 20px; background-color: #007bff; color: white; text-decoration: none; border-radius: 4px;">Create New Category</a>
    </div>

    @* Display categories in a table *@
    @if (categories != null && categories.Count > 0)
    {
        <table border="1" cellpadding="10" cellspacing="0" style="width: 100%; border-collapse: collapse;">
            <thead>
                <tr style="background-color: #f0f0f0;">
                    <th>ID</th>
                    <th>Name</th>
                    <th>Description</th>
                    <th>Products Count</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @* Loop through each category and display it in a table row *@
                @foreach (var category in categories)
                {
                    <tr>
                        <td>@category.CategoryID</td>
                        <td>@category.Name</td>
                        <td>
                            @if (!string.IsNullOrEmpty(category.Description))
                            {
                                @category.Description
                            }
                            else
                            {
                                <text>N/A</text>
                            }
                        </td>
                        <td>
                            @* Get product count for this category from dictionary *@
                            @if (productCounts != null && productCounts.ContainsKey(category.CategoryID))
                            {
                                @productCounts[category.CategoryID]
                            }
                            else
                            {
                                <text>0</text>
                            }
                        </td>
                        <td>
                            <a asp-page="Edit" asp-route-id="@category.CategoryID" style="padding: 5px 10px; background-color: #ffc107; color: #000; text-decoration: none; border-radius: 4px; margin-right: 5px;">Edit</a>
                            <a asp-page="Delete" asp-route-id="@category.CategoryID" style="padding: 5px 10px; background-color: #dc3545; color: white; text-decoration: none; border-radius: 4px;">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        @* Show message if no categories found *@
        <div style="background-color: #d1ecf1; color: #0c5460; padding: 20px; border: 1px solid #bee5eb; border-radius: 4px;">
            No categories found. <a asp-page="Create">Create the first category</a>
        </div>
    }
</div>

