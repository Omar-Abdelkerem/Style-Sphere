@page
@model StyleSphere.Pages.Admin.Categories.IndexModel
@{
    ViewData["Title"] = "Categories Management";
    var categories = ViewData["Categories"] as List<StyleSphere.Models.Category>;
    var productCounts = ViewData["ProductCounts"] as Dictionary<int, int>;
}

<div class="py-2">
    <div class="d-flex justify-content-between align-items-baseline mb-4 pb-2 border-bottom">
        <div>
            <h1 class="h3 fw-bold mb-1 text-uppercase letter-spacing-1">Categories</h1>
            <span class="text-secondary small">Department classification management</span>
        </div>
        <div class="d-flex gap-2">
            <a asp-page="Create" class="btn btn-sm btn-solid">Add Category</a>
            <a asp-page="/Admin/Index" class="btn btn-sm btn-outline-minimal">Dashboard</a>
        </div>
    </div>

    @if (categories != null && categories.Count > 0)
    {
        <div class="table-responsive">
            <table class="table-minimal align-middle">
                <thead>
                    <tr>
                        <th style="width: 70px;">ID</th>
                        <th>Category Name</th>
                        <th>Description</th>
                        <th>Products</th>
                        <th class="text-end" style="width: 140px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var category in categories)
                    {
                        var count = (productCounts != null && productCounts.ContainsKey(category.CategoryID)) ? productCounts[category.CategoryID] : 0;
                        <tr>
                            <td class="text-secondary">#@category.CategoryID</td>
                            <td>
                                <div class="fw-bold text-dark">@category.Name</div>
                            </td>
                            <td>
                                <span class="text-secondary small">@(!string.IsNullOrEmpty(category.Description) ? category.Description : "None")</span>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border rounded-0 px-2 py-1">
                                    @count items
                                </span>
                            </td>
                            <td class="text-end">
                                <a asp-page="Edit" asp-route-id="@category.CategoryID" class="btn btn-sm btn-outline-dark rounded-0 px-2 py-1 small">
                                    Edit
                                </a>
                                <a asp-page="Delete" asp-route-id="@category.CategoryID" class="btn btn-sm btn-link text-danger text-decoration-none p-0 ms-2 small">
                                    Delete
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
