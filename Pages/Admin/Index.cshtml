@page
@model StyleSphere.Pages.Admin.IndexModel
@{
    ViewData["Title"] = "Admin Dashboard";
    
    var totalProducts = ViewData["TotalProducts"] as int? ?? 0;
    var totalCategories = ViewData["TotalCategories"] as int? ?? 0;
    var totalOrders = ViewData["TotalOrders"] as int? ?? 0;
    var totalCustomers = ViewData["TotalCustomers"] as int? ?? 0;
}

<div class="py-2">
    <div class="d-flex justify-content-between align-items-baseline mb-4 pb-2 border-bottom">
        <div>
            <h1 class="h3 fw-bold mb-1 text-uppercase letter-spacing-1">Executive Dashboard</h1>
            <span class="text-secondary small">System statistics and management console</span>
        </div>
        <div class="d-flex gap-2">
            <a asp-page="/Admin/Products/Create" class="btn btn-sm btn-solid">New Product</a>
            <a asp-page="/Index" class="btn btn-sm btn-outline-minimal">View Storefront</a>
        </div>
    </div>

    <!-- 4 Minimal Stat Boxes -->
    <div class="row g-4 mb-5">
        <div class="col-xl-3 col-sm-6">
            <div class="admin-counter-box">
                <div class="title">Total Products</div>
                <div class="num">@totalProducts</div>
            </div>
        </div>

        <div class="col-xl-3 col-sm-6">
            <div class="admin-counter-box">
                <div class="title">Categories</div>
                <div class="num">@totalCategories</div>
            </div>
        </div>

        <div class="col-xl-3 col-sm-6">
            <div class="admin-counter-box">
                <div class="title">Total Orders</div>
                <div class="num">@totalOrders</div>
            </div>
        </div>

        <div class="col-xl-3 col-sm-6">
            <div class="admin-counter-box">
                <div class="title">Customers</div>
                <div class="num">@totalCustomers</div>
            </div>
        </div>
    </div>

    <!-- Management Modules -->
    <h4 class="h6 fw-bold text-uppercase letter-spacing-1 mb-3">System Sections</h4>
    <div class="row g-4 mb-4">
        <div class="col-md-6 col-lg-3">
            <div class="clean-card h-100 d-flex flex-column justify-content-between">
                <div>
                    <h5 class="fw-bold mb-2">Products</h5>
                    <p class="text-secondary small mb-4">Manage catalog items, pricing, inventory stock, and photography.</p>
                </div>
                <div class="d-flex flex-column gap-2">
                    <a asp-page="/Admin/Products/Index" class="btn btn-sm btn-outline-minimal w-100">Catalog List</a>
                    <a asp-page="/Admin/Products/Create" class="btn btn-sm btn-solid w-100">+ Add Product</a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="clean-card h-100 d-flex flex-column justify-content-between">
                <div>
                    <h5 class="fw-bold mb-2">Categories</h5>
                    <p class="text-secondary small mb-4">Organize departments, classifications, and catalog filters.</p>
                </div>
                <div class="d-flex flex-column gap-2">
                    <a asp-page="/Admin/Categories/Index" class="btn btn-sm btn-outline-minimal w-100">Category List</a>
                    <a asp-page="/Admin/Categories/Create" class="btn btn-sm btn-solid w-100">+ Add Category</a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="clean-card h-100 d-flex flex-column justify-content-between">
                <div>
                    <h5 class="fw-bold mb-2">Users</h5>
                    <p class="text-secondary small mb-4">Manage customer accounts, system administrators, and security privileges.</p>
                </div>
                <div class="d-flex flex-column gap-2">
                    <a asp-page="/Admin/Users/Index" class="btn btn-sm btn-outline-minimal w-100">User List</a>
                    <a asp-page="/Admin/Users/Create" class="btn btn-sm btn-solid w-100">+ Add User</a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="clean-card h-100 d-flex flex-column justify-content-between">
                <div>
                    <h5 class="fw-bold mb-2">Reports</h5>
                    <p class="text-secondary small mb-4">View total revenue, order fulfillment breakdown, and stock alerts.</p>
                </div>
                <div class="d-flex flex-column gap-2">
                    <a asp-page="/Admin/Reports" class="btn btn-sm btn-solid w-100">View Analytics</a>
                </div>
            </div>
        </div>
    </div>
</div>
