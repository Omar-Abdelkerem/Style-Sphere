@page
@model StyleSphere.Pages.Admin.Products.CreateModel
@{
    ViewData["Title"] = "Create Product";
    
    // Get categories from ViewData (set in the .cs file)
    var categories = ViewData["Categories"] as List<StyleSphere.Models.Category>;
}

<div style="max-width: 800px; margin: 0 auto; padding: 20px;">
    <h1>Create New Product</h1>
    <hr />

    @* Display error message if creation failed *@
    @if (ViewData["ErrorMessage"] != null)
    {
        <div style="background-color: #f8d7da; color: #721c24; padding: 15px; margin: 10px 0; border: 1px solid #f5c6cb; border-radius: 4px;">
            @ViewData["ErrorMessage"]
        </div>
    }

    <div>
        @* Create product form *@
        @* enctype="multipart/form-data" is required for file uploads *@
        @* When submitted, it will call OnPost method with all form fields *@
        <form method="post" enctype="multipart/form-data">
            @* Product name input field *@
            <div style="margin-bottom: 15px;">
                <label for="name">Product Name (Required)</label><br />
                <input type="text" name="name" id="name" required style="width: 100%; padding: 8px; margin-top: 5px; border: 1px solid #ddd; border-radius: 4px;" />
            </div>

            @* Product description textarea (optional) *@
            <div style="margin-bottom: 15px;">
                <label for="description">Description (Optional)</label><br />
                <textarea name="description" id="description" rows="4" style="width: 100%; padding: 8px; margin-top: 5px; border: 1px solid #ddd; border-radius: 4px;"></textarea>
            </div>

            @* Price and Stock in a row *@
            <div style="display: flex; gap: 15px;">
                <div style="flex: 1;">
                    @* Price input field *@
                    <div style="margin-bottom: 15px;">
                        <label for="price">Price (Required, must be > 0)</label><br />
                        <input type="number" name="price" id="price" step="0.01" min="0.01" required style="width: 100%; padding: 8px; margin-top: 5px; border: 1px solid #ddd; border-radius: 4px;" />
                    </div>
                </div>
                <div style="flex: 1;">
                    @* Stock input field *@
                    <div style="margin-bottom: 15px;">
                        <label for="stock">Stock (Required, must be >= 0)</label><br />
                        <input type="number" name="stock" id="stock" min="0" required style="width: 100%; padding: 8px; margin-top: 5px; border: 1px solid #ddd; border-radius: 4px;" />
                    </div>
                </div>
            </div>

            @* Category dropdown *@
            <div style="margin-bottom: 15px;">
                <label for="categoryId">Category (Required)</label><br />
                <select name="categoryId" id="categoryId" required style="width: 100%; padding: 8px; margin-top: 5px; border: 1px solid #ddd; border-radius: 4px;">
                    <option value="">-- Select Category --</option>
                    @* Loop through categories to create dropdown options *@
                    @if (categories != null)
                    {
                        @foreach (var category in categories)
                        {
                            <option value="@category.CategoryID">@category.Name</option>
                        }
                    }
                </select>
            </div>

            @* Image file upload *@
            <div style="margin-bottom: 15px;">
                <label for="imageFile">Product Image (Optional)</label><br />
                <input type="file" name="imageFile" id="imageFile" accept="image/*" style="width: 100%; padding: 8px; margin-top: 5px; border: 1px solid #ddd; border-radius: 4px;" />
                <small style="color: #6c757d;">Accepted formats: JPG, PNG, GIF. Max size: 5MB</small>
            </div>

            @* Submit button *@
            <div style="margin-bottom: 15px;">
                <button type="submit" style="padding: 10px 20px; background-color: #007bff; color: white; border: none; border-radius: 4px; cursor: pointer; margin-right: 10px;">Create</button>
                <a asp-page="Index" style="padding: 10px 20px; background-color: #6c757d; color: white; text-decoration: none; border-radius: 4px; display: inline-block;">Cancel</a>
            </div>
        </form>
    </div>
</div>

