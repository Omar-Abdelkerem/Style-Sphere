@page "{id:int}"
@model StyleSphere.Pages.Admin.Products.EditModel
@{
    ViewData["Title"] = "Edit Product";
    var product = ViewData["Product"] as StyleSphere.Models.Product;
    var categories = ViewData["Categories"] as List<StyleSphere.Models.Category>;
}

<div class="py-2" style="max-width: 800px; margin: 0 auto;">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 small">
                    <li class="breadcrumb-item"><a asp-page="/Admin/Index" class="text-decoration-none">Admin</a></li>
                    <li class="breadcrumb-item"><a asp-page="Index" class="text-decoration-none">Products</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Edit Product</li>
                </ol>
            </nav>
            <h1 class="h2 fw-bold mb-0">Modify Product: @product?.Name</h1>
        </div>
        <a asp-page="Index" class="btn btn-outline-secondary rounded-pill px-3 py-2 btn-sm fw-semibold">
            <i class="bi bi-arrow-left me-1"></i> Back to Products
        </a>
    </div>

    @if (ViewData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger rounded-4 p-3 mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @ViewData["ErrorMessage"]
        </div>
    }

    @if (product != null)
    {
        <div class="card border-0 rounded-4 shadow-sm p-4 p-md-5">
            <form method="post" enctype="multipart/form-data">
                <input type="hidden" name="productId" value="@product.ProductID" />

                <div class="mb-3">
                    <label for="name" class="form-label small fw-bold text-muted">Product Name <span class="text-danger">*</span></label>
                    <input type="text" name="name" id="name" value="@product.Name" class="form-control rounded-pill px-3 shadow-none" required />
                </div>

                <div class="mb-3">
                    <label for="description" class="form-label small fw-bold text-muted">Description</label>
                    <textarea name="description" id="description" rows="3" class="form-control rounded-4 shadow-none px-3">@product.Description</textarea>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-sm-6">
                        <label for="price" class="form-label small fw-bold text-muted">Price ($) <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light rounded-start-pill border-end-0 text-muted ps-3">$</span>
                            <input type="number" name="price" id="price" step="0.01" min="0.01" value="@product.Price" class="form-control rounded-end-pill border-start-0 shadow-none ps-2" required />
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <label for="stock" class="form-label small fw-bold text-muted">Stock Quantity <span class="text-danger">*</span></label>
                        <input type="number" name="stock" id="stock" min="0" value="@product.Stock" class="form-control rounded-pill px-3 shadow-none" required />
                    </div>
                </div>

                <div class="mb-3">
                    <label for="categoryId" class="form-label small fw-bold text-muted">Category Department <span class="text-danger">*</span></label>
                    <select name="categoryId" id="categoryId" class="form-select rounded-pill px-3 shadow-none" required>
                        <option value="">-- Choose Category --</option>
                        @if (categories != null)
                        {
                            @foreach (var category in categories)
                            {
                                var isSel = category.CategoryID == product.CategoryID;
                                <option value="@category.CategoryID" selected="@isSel">@category.Name</option>
                            }
                        }
                    </select>
                </div>

                <!-- Current Image & Upload -->
                <div class="row g-3 align-items-center mb-4 p-3 bg-light rounded-4 border">
                    <div class="col-sm-4 text-center">
                        <div class="small fw-bold text-muted mb-2">Current Image</div>
                        @if (!string.IsNullOrEmpty(product.ImageName))
                        {
                            <div style="width: 100px; height: 100px; margin: 0 auto; border-radius: 12px; overflow: hidden; background: white; border: 1px solid var(--border-color);">
                                <img src="~/images/products/@product.ImageName" alt="@product.Name" style="width: 100%; height: 100%; object-fit: cover;" />
                            </div>
                        }
                        else
                        {
                            <span class="text-muted small">No image uploaded</span>
                        }
                    </div>
                    <div class="col-sm-8">
                        <label for="imageFile" class="form-label small fw-bold text-muted">Replace Image (Optional)</label>
                        <input type="file" name="imageFile" id="imageFile" accept="image/*" class="form-control rounded-pill px-3 shadow-none" />
                        <div class="form-text small">Leave blank to retain current image.</div>
                    </div>
                </div>

                <div class="d-flex gap-2 pt-2 border-top">
                    <button type="submit" class="btn btn-primary-custom rounded-pill px-4 py-2 fw-semibold">
                        <i class="bi bi-check-lg me-1"></i> Update Product
                    </button>
                    <a asp-page="Index" class="btn btn-outline-secondary rounded-pill px-4 py-2 fw-semibold">
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    }
</div>
