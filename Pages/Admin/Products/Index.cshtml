@page
@model StyleSphere.Pages.Admin.Products.IndexModel
@{
    ViewData["Title"] = "Products Management";
    var products = ViewData["Products"] as List<StyleSphere.Models.Product>;
}

<div class="py-2">
    <div class="d-flex justify-content-between align-items-baseline mb-4 pb-2 border-bottom">
        <div>
            <h1 class="h3 fw-bold mb-1 text-uppercase letter-spacing-1">Products Catalog</h1>
            <span class="text-secondary small">Inventory and merchandise control</span>
        </div>
        <div class="d-flex gap-2">
            <a asp-page="Create" class="btn btn-sm btn-solid">Add Product</a>
            <a asp-page="/Admin/Index" class="btn btn-sm btn-outline-minimal">Dashboard</a>
        </div>
    </div>

    @if (products != null && products.Count > 0)
    {
        <div class="table-responsive">
            <table class="table-minimal align-middle">
                <thead>
                    <tr>
                        <th style="width: 70px;">ID</th>
                        <th style="width: 80px;">Photo</th>
                        <th>Product Name</th>
                        <th>Category</th>
                        <th>Price</th>
                        <th>Stock</th>
                        <th class="text-end" style="width: 140px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var product in products)
                    {
                        <tr>
                            <td class="text-secondary">#@product.ProductID</td>
                            <td>
                                <div style="width: 50px; height: 65px; overflow: hidden; background: #f4f4f4; border: 1px solid var(--border);">
                                    @if (!string.IsNullOrEmpty(product.ImageName))
                                    {
                                        <img src="~/images/products/@product.ImageName" alt="@product.Name" style="width: 100%; height: 100%; object-fit: cover;" />
                                    }
                                    else
                                    {
                                        <div class="small text-muted text-center pt-3">None</div>
                                    }
                                </div>
                            </td>
                            <td>
                                <div class="fw-bold text-dark">@product.Name</div>
                                <small class="text-secondary text-truncate d-block" style="max-width: 300px;">@product.Description</small>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border rounded-0 px-2 py-1">
                                    @(product.Category?.Name ?? "Unassigned")
                                </span>
                            </td>
                            <td class="fw-bold text-dark">
                                $@product.Price.ToString("F2")
                            </td>
                            <td>
                                @if (product.Stock > 10)
                                {
                                    <span class="small text-success fw-bold">@product.Stock in stock</span>
                                }
                                else if (product.Stock > 0)
                                {
                                    <span class="small text-danger fw-bold">Low: @product.Stock left</span>
                                }
                                else
                                {
                                    <span class="small text-muted">Out of stock</span>
                                }
                            </td>
                            <td class="text-end">
                                <a asp-page="Edit" asp-route-id="@product.ProductID" class="btn btn-sm btn-outline-dark rounded-0 px-2 py-1 small">
                                    Edit
                                </a>
                                <a asp-page="Delete" asp-route-id="@product.ProductID" class="btn btn-sm btn-link text-danger text-decoration-none p-0 ms-2 small">
                                    Delete
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="py-5 text-center text-muted border my-4">
            <h5 class="fw-bold mb-2">No Products Available</h5>
            <p class="small mb-3">Add items to populate the inventory.</p>
            <a asp-page="Create" class="btn btn-sm btn-solid">Add Product</a>
        </div>
    }
</div>
