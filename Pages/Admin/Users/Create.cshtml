@page
@model StyleSphere.Pages.Admin.Users.CreateModel
@{
    ViewData["Title"] = "Create User";
}

<div class="py-2" style="max-width: 700px; margin: 0 auto;">
    <div class="d-flex justify-content-between align-items-baseline mb-4 pb-2 border-bottom">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 small">
                    <li class="breadcrumb-item"><a asp-page="/Admin/Index" class="text-secondary">Admin</a></li>
                    <li class="breadcrumb-item"><a asp-page="Index" class="text-secondary">Users</a></li>
                    <li class="breadcrumb-item active text-dark" aria-current="page">New User</li>
                </ol>
            </nav>
            <h1 class="h3 fw-bold mb-0 text-uppercase letter-spacing-1">Register User Account</h1>
        </div>
        <a asp-page="Index" class="btn btn-sm btn-outline-minimal">
            &larr; Back
        </a>
    </div>

    @if (ViewData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger rounded-0 py-2 px-3 small mb-4" role="alert">
            @ViewData["ErrorMessage"]
        </div>
    }

    <div class="clean-card">
        <form method="post">
            <div class="mb-3">
                <label for="name" class="form-label">Full Name <span class="text-danger">*</span></label>
                <input type="text" name="name" id="name" class="form-control" placeholder="e.g. Eleanor Rigby" maxlength="100" required />
            </div>

            <div class="mb-3">
                <label for="email" class="form-label">Email Address <span class="text-danger">*</span></label>
                <input type="email" name="email" id="email" class="form-control" placeholder="e.g. eleanor@example.com" maxlength="100" required />
            </div>

            <div class="mb-3">
                <label for="phone" class="form-label">Phone Number (Optional)</label>
                <input type="tel" name="phone" id="phone" class="form-control" placeholder="+1 (555) 000-0000" maxlength="20" />
            </div>

            <div class="mb-3">
                <label for="password" class="form-label">Initial Password <span class="text-danger">*</span></label>
                <input type="password" name="password" id="password" class="form-control" placeholder="Minimum 6 characters" minlength="6" maxlength="255" required />
            </div>

            <div class="mb-4">
                <label for="role" class="form-label">Access Level / Role <span class="text-danger">*</span></label>
                <select name="role" id="role" class="form-select" required>
                    <option value="Customer" selected>Customer (Standard Storefront Access)</option>
                    <option value="Admin">Admin (Full Control Panel Privileges)</option>
                </select>
            </div>

            <div class="d-flex gap-2 pt-3 border-top">
                <button type="submit" class="btn btn-solid">
                    Create User
                </button>
                <a asp-page="Index" class="btn btn-outline-minimal">
                    Cancel
                </a>
            </div>
        </form>
    </div>
</div>
