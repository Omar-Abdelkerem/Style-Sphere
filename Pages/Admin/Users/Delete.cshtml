@page "{id:int}"
@model StyleSphere.Pages.Admin.Users.DeleteModel
@{
    ViewData["Title"] = "Delete User";
    var user = ViewData["User"] as StyleSphere.Models.User;
}

<div class="py-2" style="max-width: 700px; margin: 0 auto;">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 small">
                    <li class="breadcrumb-item"><a asp-page="/Admin/Index" class="text-decoration-none">Admin</a></li>
                    <li class="breadcrumb-item"><a asp-page="Index" class="text-decoration-none">Users</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Delete User</li>
                </ol>
            </nav>
            <h1 class="h2 fw-bold mb-0 text-danger">Remove User Account</h1>
        </div>
        <a asp-page="Index" class="btn btn-outline-secondary rounded-pill px-3 py-2 btn-sm fw-semibold">
            <i class="bi bi-arrow-left me-1"></i> Cancel
        </a>
    </div>

    @if (user != null)
    {
        <div class="card border-0 rounded-4 shadow-sm p-4 p-md-5">
            <div class="alert alert-danger rounded-4 d-flex align-items-center gap-3 p-3 mb-4">
                <i class="bi bi-exclamation-triangle-fill fs-2"></i>
                <div>
                    <h5 class="fw-bold mb-1">Confirm Account Termination</h5>
                    <p class="small mb-0">Are you sure you want to permanently remove <strong>@user.Name</strong> (@user.Email)? This action cannot be reversed.</p>
                </div>
            </div>

            <div class="p-3 bg-light rounded-4 mb-4 border">
                <div class="d-flex align-items-center gap-3 mb-2">
                    <div class="avatar-circle">@user.Name.Substring(0, 1).ToUpper()</div>
                    <div>
                        <h5 class="fw-bold mb-0">@user.Name</h5>
                        <div class="text-muted small">@user.Email</div>
                    </div>
                </div>
                <div class="small text-muted mt-2">
                    Role: <span class="badge bg-secondary rounded-pill">@user.Role</span> | Phone: @(!string.IsNullOrEmpty(user.Phone) ? user.Phone : "N/A")
                </div>
            </div>

            <form method="post" class="d-flex gap-2">
                <input type="hidden" name="id" value="@user.UserID" />
                <button type="submit" class="btn btn-danger rounded-pill px-4 py-2 fw-semibold">
                    <i class="bi bi-trash3 me-1"></i> Permanently Delete
                </button>
                <a asp-page="Index" class="btn btn-outline-secondary rounded-pill px-4 py-2 fw-semibold">
                    Cancel
                </a>
            </form>
        </div>
    }
</div>
