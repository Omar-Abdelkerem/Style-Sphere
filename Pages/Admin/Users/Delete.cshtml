@page "{id:int}"
@model StyleSphere.Pages.Admin.Users.DeleteModel
@{
    ViewData["Title"] = "Delete User";
    
    // Get user from ViewData (set in the .cs file)
    var user = ViewData["User"] as StyleSphere.Models.User;
}

<div style="max-width: 800px; margin: 0 auto; padding: 20px;">
    <h1>Delete User</h1>
    <hr />

    @if (user != null)
    {
        <h3>Are you sure you want to delete this user?</h3>
        
        @* Display user information *@
        <div>
            <table border="1" cellpadding="10" cellspacing="0" style="width: 100%; border-collapse: collapse; margin: 20px 0;">
                <tr>
                    <th style="background-color: #f0f0f0;">User ID:</th>
                    <td>@user.UserID</td>
                </tr>
                <tr>
                    <th style="background-color: #f0f0f0;">Name:</th>
                    <td>@user.Name</td>
                </tr>
                <tr>
                    <th style="background-color: #f0f0f0;">Email:</th>
                    <td>@user.Email</td>
                </tr>
                <tr>
                    <th style="background-color: #f0f0f0;">Phone:</th>
                    <td>
                        @if (!string.IsNullOrEmpty(user.Phone))
                        {
                            @user.Phone
                        }
                        else
                        {
                            <text>N/A</text>
                        }
                    </td>
                </tr>
                <tr>
                    <th style="background-color: #f0f0f0;">Role:</th>
                    <td>@user.Role</td>
                </tr>
            </table>

            @* Delete form *@
            @* When submitted, it will call OnPost method with id *@
            <form method="post">
                <input type="hidden" name="id" value="@user.UserID" />
                <button type="submit" style="padding: 10px 20px; background-color: #dc3545; color: white; border: none; border-radius: 4px; cursor: pointer; margin-right: 10px;">Delete</button>
                <a asp-page="Index" style="padding: 10px 20px; background-color: #6c757d; color: white; text-decoration: none; border-radius: 4px; display: inline-block;">Cancel</a>
            </form>
        </div>
    }
</div>

