@page "{id:int}"
@model StyleSphere.Pages.Admin.Users.DeleteModel
@{
    ViewData["Title"] = "Delete User";
    var user = ViewData["User"] as StyleSphere.Models.User;
}

<div class="py-2" style="max-width: 700px; margin: 0 auto;">
    <div class="d-flex justify-content-between align-items-baseline mb-4 pb-2 border-bottom">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 small">
                    <li class="breadcrumb-item"><a asp-page="/Admin/Index" class="text-secondary">Admin</a></li>
                    <li class="breadcrumb-item"><a asp-page="Index" class="text-secondary">Users</a></li>
                    <li class="breadcrumb-item active text-dark" aria-current="page">Delete User</li>
                </ol>
            </nav>
            <h1 class="h3 fw-bold mb-0 text-uppercase letter-spacing-1 text-danger">Remove User Account</h1>
        </div>
        <a asp-page="Index" class="btn btn-sm btn-outline-minimal">
            &larr; Cancel
        </a>
    </div>

    @if (user != null)
    {
        <div class="clean-card">
            <div class="alert alert-danger rounded-0 p-3 mb-4">
                <h2 class="h6 fw-bold mb-1 text-uppercase">Confirm Account Termination</h2>
                <p class="small mb-0">Are you sure you want to permanently remove <strong>@user.Name</strong> (@user.Email)? This action cannot be reversed.</p>
            </div>

            <div class="p-3 bg-light mb-4 border">
                <div class="fw-bold mb-1">@user.Name</div>
                <div class="text-secondary small">@user.Email</div>
                <div class="small text-secondary mt-2">
                    Role: <span class="badge bg-white text-dark border rounded-0">@user.Role</span> | Phone: @(!string.IsNullOrEmpty(user.Phone) ? user.Phone : "N/A")
                </div>
            </div>

            <form method="post" class="d-flex gap-2">
                <input type="hidden" name="id" value="@user.UserID" />
                <button type="submit" class="btn btn-danger rounded-0 px-4 py-2 text-uppercase small fw-bold">
                    Permanently Delete
                </button>
                <a asp-page="Index" class="btn btn-outline-minimal">
                    Cancel
                </a>
            </form>
        </div>
    }
</div>
