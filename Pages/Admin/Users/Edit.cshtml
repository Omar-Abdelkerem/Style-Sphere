@page "{id:int}"
@model StyleSphere.Pages.Admin.Users.EditModel
@{
    ViewData["Title"] = "Edit User";
    
    // Get user from ViewData (set in the .cs file)
    var user = ViewData["User"] as StyleSphere.Models.User;
}

<div style="max-width: 800px; margin: 0 auto; padding: 20px;">
    <h1>Edit User</h1>
    <hr />

    @* Display error message if update failed *@
    @if (ViewData["ErrorMessage"] != null)
    {
        <div style="background-color: #f8d7da; color: #721c24; padding: 15px; margin: 10px 0; border: 1px solid #f5c6cb; border-radius: 4px;">
            @ViewData["ErrorMessage"]
        </div>
    }

    @if (user != null)
    {
        <div>
            @* Edit user form *@
            @* When submitted, it will call OnPost method with all form fields *@
            <form method="post">
                @* Hidden field to pass user ID *@
                <input type="hidden" name="userId" value="@user.UserID" />

                @* User name input field *@
                <div style="margin-bottom: 15px;">
                    <label for="name">Name (Required)</label><br />
                    <input type="text" name="name" id="name" value="@user.Name" required style="width: 100%; padding: 8px; margin-top: 5px; border: 1px solid #ddd; border-radius: 4px;" />
                </div>

                @* Email input field *@
                <div style="margin-bottom: 15px;">
                    <label for="email">Email (Required)</label><br />
                    <input type="email" name="email" id="email" value="@user.Email" required style="width: 100%; padding: 8px; margin-top: 5px; border: 1px solid #ddd; border-radius: 4px;" />
                    <small style="color: #6c757d;">Email must be unique.</small>
                </div>

                @* Phone input field (optional) *@
                <div style="margin-bottom: 15px;">
                    <label for="phone">Phone (Optional)</label><br />
                    <input type="tel" name="phone" id="phone" value="@user.Phone" style="width: 100%; padding: 8px; margin-top: 5px; border: 1px solid #ddd; border-radius: 4px;" />
                </div>

                @* Password input field (optional - leave empty to keep current) *@
                <div style="margin-bottom: 15px;">
                    <label for="password">Password (Optional - leave empty to keep current)</label><br />
                    <input type="password" name="password" id="password" placeholder="Leave empty to keep current password" style="width: 100%; padding: 8px; margin-top: 5px; border: 1px solid #ddd; border-radius: 4px;" />
                    <small style="color: #6c757d;">If you want to change the password, enter a new one (minimum 6 characters).</small>
                </div>

                @* Role dropdown *@
                <div style="margin-bottom: 15px;">
                    <label for="role">Role (Required)</label><br />
                    <select name="role" id="role" required style="width: 100%; padding: 8px; margin-top: 5px; border: 1px solid #ddd; border-radius: 4px;">
                        @* If current role is Customer, mark it as selected *@
                        @if (user.Role == "Customer")
                        {
                            <option value="Customer" selected>Customer</option>
                            <option value="Admin">Admin</option>
                        }
                        else
                        {
                            <option value="Customer">Customer</option>
                            <option value="Admin" selected>Admin</option>
                        }
                    </select>
                </div>

                @* Submit button *@
                <div style="margin-bottom: 15px;">
                    <button type="submit" style="padding: 10px 20px; background-color: #007bff; color: white; border: none; border-radius: 4px; cursor: pointer; margin-right: 10px;">Save</button>
                    <a asp-page="Index" style="padding: 10px 20px; background-color: #6c757d; color: white; text-decoration: none; border-radius: 4px; display: inline-block;">Cancel</a>
                </div>
            </form>
        </div>
    }
</div>

