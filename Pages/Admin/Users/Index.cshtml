@page
@model StyleSphere.Pages.Admin.Users.IndexModel
@{
    ViewData["Title"] = "Users Management";
    var users = ViewData["Users"] as List<StyleSphere.Models.User>;
}

<div class="py-2">
    <div class="d-flex justify-content-between align-items-baseline mb-4 pb-2 border-bottom">
        <div>
            <h1 class="h3 fw-bold mb-1 text-uppercase letter-spacing-1">User Accounts</h1>
            <span class="text-secondary small">Access permissions and user profiles</span>
        </div>
        <div class="d-flex gap-2">
            <a asp-page="Create" class="btn btn-sm btn-solid">Add User</a>
            <a asp-page="/Admin/Index" class="btn btn-sm btn-outline-minimal">Dashboard</a>
        </div>
    </div>

    @if (users != null && users.Count > 0)
    {
        <div class="table-responsive">
            <table class="table-minimal align-middle">
                <thead>
                    <tr>
                        <th style="width: 70px;">ID</th>
                        <th>User Name</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Role</th>
                        <th class="text-end" style="width: 140px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in users)
                    {
                        <tr>
                            <td class="text-secondary">#@user.UserID</td>
                            <td>
                                <div class="fw-bold text-dark">@user.Name</div>
                            </td>
                            <td>
                                <span class="text-secondary">@user.Email</span>
                            </td>
                            <td>
                                <span class="text-secondary small">@(!string.IsNullOrEmpty(user.Phone) ? user.Phone : "None")</span>
                            </td>
                            <td>
                                @if (user.Role == "Admin")
                                {
                                    <span class="badge bg-dark text-white rounded-0 px-2 py-1">Administrator</span>
                                }
                                else
                                {
                                    <span class="badge bg-light text-dark border rounded-0 px-2 py-1">Customer</span>
                                }
                            </td>
                            <td class="text-end">
                                <a asp-page="Edit" asp-route-id="@user.UserID" class="btn btn-sm btn-outline-dark rounded-0 px-2 py-1 small">
                                    Edit
                                </a>
                                <a asp-page="Delete" asp-route-id="@user.UserID" class="btn btn-sm btn-link text-danger text-decoration-none p-0 ms-2 small">
                                    Delete
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
