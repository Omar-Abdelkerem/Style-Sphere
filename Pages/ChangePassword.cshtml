@page
@model StyleSphere.Pages.ChangePasswordModel
@{
    ViewData["Title"] = "Change Password";
}

<div style="max-width: 600px; margin: 40px auto; padding: 20px;">
    <div style="border: 1px solid #ddd; padding: 20px; border-radius: 4px;">
        <h3 style="margin-top: 0;">Change Password</h3>
        
        @* Display error message if password change failed *@
        @if (ViewData["ErrorMessage"] != null)
        {
            <div style="background-color: #f8d7da; color: #721c24; padding: 15px; margin: 10px 0; border: 1px solid #f5c6cb; border-radius: 4px;">
                @ViewData["ErrorMessage"]
            </div>
        }
        
        @* Display success message if password changed successfully *@
        @if (ViewData["SuccessMessage"] != null)
        {
            <div style="background-color: #d4edda; color: #155724; padding: 15px; margin: 10px 0; border: 1px solid #c3e6cb; border-radius: 4px;">
                @ViewData["SuccessMessage"]
            </div>
        }

        @* Change password form *@
        @* When submitted, it will call OnPost method with oldPassword, newPassword, and confirmPassword *@
        <form method="post">
            @* Current password input *@
            <div style="margin-bottom: 15px;">
                <label for="oldPassword">Current Password</label><br />
                <input type="password" name="oldPassword" id="oldPassword" required style="width: 100%; padding: 8px; margin-top: 5px; border: 1px solid #ddd; border-radius: 4px;" />
            </div>

            @* New password input *@
            <div style="margin-bottom: 15px;">
                <label for="newPassword">New Password (minimum 6 characters)</label><br />
                <input type="password" name="newPassword" id="newPassword" required style="width: 100%; padding: 8px; margin-top: 5px; border: 1px solid #ddd; border-radius: 4px;" />
            </div>

            @* Confirm new password input *@
            <div style="margin-bottom: 15px;">
                <label for="confirmPassword">Confirm New Password</label><br />
                <input type="password" name="confirmPassword" id="confirmPassword" required style="width: 100%; padding: 8px; margin-top: 5px; border: 1px solid #ddd; border-radius: 4px;" />
            </div>

            @* Submit button *@
            <div>
                <button type="submit" style="width: 100%; padding: 10px; background-color: #007bff; color: white; border: none; border-radius: 4px; cursor: pointer;">Change Password</button>
            </div>
        </form>
    </div>
</div>

