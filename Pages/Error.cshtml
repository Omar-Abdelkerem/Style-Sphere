@page
@model ErrorModel
@{
    ViewData["Title"] = "Service Interruption - StyleSphere";
    ViewData["MetaDescription"] = "An unexpected error occurred while processing your request.";
    Layout = "_CustomerLayout";
}

<div class="container py-5">
    <div style="max-width: 540px; margin: 40px auto;" class="clean-card text-center">
        <div class="text-uppercase small fw-bold text-secondary letter-spacing-1 mb-2">System Notice</div>
        <h1 class="h3 fw-bold mb-3 text-uppercase">Unable to Complete Request</h1>
        <p class="text-secondary small mb-4">
            We encountered a temporary issue while processing your request. Please try again in a moment or return to our storefront catalog.
        </p>
        <div class="d-flex justify-content-center gap-3">
            <a asp-page="/Index" class="btn btn-solid">Return to Storefront</a>
            <a asp-page="/Products" class="btn btn-outline-minimal">Browse Catalog</a>
        </div>
    </div>
</div>
