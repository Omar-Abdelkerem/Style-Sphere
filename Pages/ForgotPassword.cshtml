@page
@model StyleSphere.Pages.ForgotPasswordModel
@{
    ViewData["Title"] = "Reset Password - StyleSphere";
    ViewData["MetaDescription"] = "Request a secure password reset link for your StyleSphere account.";
    Layout = "_CustomerLayout";
}

<div class="container py-5">
    <div style="max-width: 440px; margin: 40px auto;">
        <div class="clean-card">
            <h1 class="h4 fw-bold text-center mb-1 text-uppercase letter-spacing-1">Password Recovery</h1>
            <p class="text-secondary small text-center mb-4">Enter your registered email address to request a single-use password reset link.</p>

            @if (ViewData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger rounded-0 py-2 px-3 small mb-3" role="alert">
                    @ViewData["ErrorMessage"]
                </div>
            }

            @if (ViewData["SuccessMessage"] != null)
            {
                <div class="alert alert-dark rounded-0 py-2 px-3 small mb-3" role="alert">
                    @ViewData["SuccessMessage"]
                </div>

                @if (ViewData["DevResetToken"] != null)
                {
                    <div class="p-3 bg-light border small mb-3">
                        <div class="fw-bold mb-1">Local Development Reset Link:</div>
                        <a asp-page="/ResetPassword" asp-route-token="@ViewData["DevResetToken"]" class="text-dark text-decoration-underline break-all">
                            Continue to Reset Password &rarr;
                        </a>
                    </div>
                }
            }

            <form method="post">
                <div class="mb-4">
                    <label for="email" class="form-label">Email Address</label>
                    <input type="email" name="email" id="email" class="form-control" placeholder="name@domain.com" maxlength="100" required />
                </div>

                <button type="submit" class="btn btn-solid w-100 py-3 mb-3">
                    Send Reset Instructions
                </button>
            </form>

            <div class="text-center small text-secondary">
                Remembered your password? <a asp-page="/login" class="text-dark fw-bold">Return to Sign In</a>
            </div>
        </div>
    </div>
</div>
