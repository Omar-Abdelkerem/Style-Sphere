@page
@model StyleSphere.Pages.IndexModel
@{
    ViewData["Title"] = "StyleSphere - Contemporary Fashion & Essentials";
    ViewData["MetaDescription"] = "Discover StyleSphere's Spring/Summer 2026 collection: tailored wool outerwear, breathable organic cottons, footwear, and artisan leather accessories.";
    Layout = "_CustomerLayout";
    var products = ViewData["Products"] as List<StyleSphere.Models.Product>;
}

<div class="container py-4 pb-5">
    <!-- Editorial Minimal Hero -->
    <div class="hero-minimal">
        <div class="row align-items-center">
            <div class="col-lg-7">
                <div class="hero-tag">Spring / Summer 2026</div>
                <h1>Modern Wardrobe Essentials</h1>
                <p>
                    A curated selection of tailored outerwear, breathable organic cottons, and contemporary leather goods engineered for daily refinement.
                </p>
                <div class="d-flex flex-wrap gap-3">
                    <a asp-page="/Products" class="btn btn-solid">
                        Shop All Products
                    </a>
                    <a asp-page="/Products" asp-route-categoryId="1" class="btn btn-outline-minimal">
                        Men
                    </a>
                    <a asp-page="/Products" asp-route-categoryId="2" class="btn btn-outline-minimal">
                        Women
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Category Filter Tabs -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="h5 fw-bold mb-0 text-uppercase letter-spacing-1">Featured Arrivals</h2>
        <a asp-page="/Products" class="small fw-semibold text-dark text-uppercase letter-spacing-1">View All &rarr;</a>
    </div>

    <div class="filter-tabs">
        <a asp-page="/Products" class="filter-tab-link active">All Pieces</a>
        <a asp-page="/Products" asp-route-categoryId="1" class="filter-tab-link">Men</a>
        <a asp-page="/Products" asp-route-categoryId="2" class="filter-tab-link">Women</a>
        <a asp-page="/Products" asp-route-categoryId="3" class="filter-tab-link">Shoes</a>
        <a asp-page="/Products" asp-route-categoryId="4" class="filter-tab-link">Accessories</a>
    </div>

    <!-- Real Photo Product Grid -->
    @if (products != null && products.Count > 0)
    {
        <div class="product-grid">
            @foreach (var product in products)
            {
                <article class="product-item">
                    <!-- Real Product Photo Link -->
                    <a asp-page="/details" asp-route-id="@product.ProductID" class="product-image-container text-decoration-none">
                        @if (!string.IsNullOrEmpty(product.ImageName))
                        {
                            <img src="~/images/products/@product.ImageName" alt="@product.Name" width="600" height="800" loading="lazy" />
                        }
                        else
                        {
                            <div class="d-flex align-items-center justify-content-center h-100 w-100 text-secondary">
                                <i class="bi bi-image fs-2" aria-hidden="true"></i>
                            </div>
                        }
                    </a>

                    <!-- Category Tag -->
                    <div class="product-meta-cat">
                        @(product.Category?.Name ?? "Apparel")
                    </div>

                    <!-- Title -->
                    <h3 class="h6 mb-1">
                        <a asp-page="/details" asp-route-id="@product.ProductID" class="text-decoration-none product-meta-title d-block">
                            @product.Name
                        </a>
                    </h3>

                    <!-- Price -->
                    <div class="product-meta-price">
                        $@product.Price.ToString("F2")
                    </div>

                    <!-- Stock Status -->
                    <div class="product-meta-stock @(product.Stock <= 10 ? "low" : "")">
                        @if (product.Stock > 10)
                        {
                            <span>In Stock (@product.Stock)</span>
                        }
                        else if (product.Stock > 0)
                        {
                            <span>Low Stock (@product.Stock left)</span>
                        }
                        else
                        {
                            <span>Sold Out</span>
                        }
                    </div>

                    <!-- Add to Bag Form -->
                    @if (product.Stock > 0)
                    {
                        <form method="post" asp-page="/AddToCart" class="m-0 mt-auto">
                            <input type="hidden" name="productId" value="@product.ProductID" />
                            <input type="hidden" name="quantity" value="1" />
                            <button type="submit" class="btn btn-add-bag">
                                Add to Bag
                            </button>
                        </form>
                    }
                    else
                    {
                        <button class="btn btn-add-bag disabled" disabled style="opacity: 0.5;">Out of Stock</button>
                    }
                </article>
            }
        </div>
    }
    else
    {
        <div class="py-5 text-center text-secondary">
            <p>No products available currently.</p>
        </div>
    }
</div>
