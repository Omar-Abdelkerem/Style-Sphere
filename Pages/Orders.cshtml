@page
@model StyleSphere.Pages.OrdersModel
@{
    ViewData["Title"] = "Order History - StyleSphere";
    Layout = "_CustomerLayout";
    var orders = ViewData["Orders"] as List<StyleSphere.Models.Order>;
}

<div class="container py-4 pb-5">
    <div class="d-flex justify-content-between align-items-baseline mb-4 pb-2 border-bottom">
        <div>
            <h1 class="h3 fw-bold mb-1 text-uppercase letter-spacing-1">Order History</h1>
            <span class="text-secondary small">Review past purchases and fulfillment status</span>
        </div>
        <a asp-page="/Products" class="small fw-semibold text-dark text-uppercase letter-spacing-1">
            Shop Catalog &rarr;
        </a>
    </div>

    @if (orders != null && orders.Count > 0)
    {
        <div class="table-responsive">
            <table class="table-minimal">
                <thead>
                    <tr>
                        <th>Order Reference</th>
                        <th>Date Placed</th>
                        <th>Fulfillment</th>
                        <th>Quantity</th>
                        <th>Total</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in orders)
                    {
                        <tr>
                            <td class="fw-semibold">
                                #ORD-@order.OrderID.ToString("D5")
                            </td>
                            <td>
                                @order.OrderDate.ToString("MMMM dd, yyyy")
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border rounded-0 fw-semibold px-2 py-1">
                                    @order.Status
                                </span>
                            </td>
                            <td>
                                @(order.OrderItems?.Count ?? 0) @((order.OrderItems?.Count ?? 0) == 1 ? "item" : "items")
                            </td>
                            <td class="fw-bold">
                                $@order.TotalAmount.ToString("F2")
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="py-5 text-center text-muted border my-4">
            <h4 class="fw-bold mb-2">No Past Orders Found</h4>
            <p class="small mb-4">You have not placed any orders yet.</p>
            <a asp-page="/Products" class="btn btn-sm btn-solid">
                Explore Catalog
            </a>
        </div>
    }
</div>
