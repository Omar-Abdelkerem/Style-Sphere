@page
@model StyleSphere.Pages.PlaceOrderModel
@{
    ViewData["Title"] = "Place Order";
    
    // Get totals from ViewData (set in the .cs file)
    var subtotal = ViewData["Subtotal"] as decimal? ?? 0;
    var tax = ViewData["Tax"] as decimal? ?? 0;
    var total = ViewData["Total"] as decimal? ?? 0;
}

<div style="max-width: 800px; margin: 0 auto; padding: 20px;">
    <h1>Place Order</h1>
    <hr />

    @* Display error message if order placement failed *@
    @if (!string.IsNullOrEmpty((string?)TempData["ErrorMessage"]))
    {
        <div style="background-color: #f8d7da; color: #721c24; padding: 15px; margin: 10px 0; border: 1px solid #f5c6cb; border-radius: 4px;">
            @TempData["ErrorMessage"]
        </div>
    }

    @* Order summary *@
    <div style="border: 1px solid #ddd; padding: 15px; margin-bottom: 20px;">
        <h3 style="margin-top: 0;">Order Summary</h3>
        <div style="display: flex; justify-content: space-between; margin-bottom: 10px;">
            <span>Subtotal:</span>
            <span>$@subtotal.ToString("F2")</span>
        </div>
        <div style="display: flex; justify-content: space-between; margin-bottom: 10px;">
            <span>Tax (14%):</span>
            <span>$@tax.ToString("F2")</span>
        </div>
        <hr />
        <div style="display: flex; justify-content: space-between;">
            <strong>Total:</strong>
            <strong>$@total.ToString("F2")</strong>
        </div>
    </div>

    @* Payment method form *@
    @* When submitted, it will call OnPost method with paymentMethod *@
    <form method="post">
        <div style="margin-bottom: 15px;">
            <label for="paymentMethod">Payment Method</label><br />
            <select name="paymentMethod" id="paymentMethod" required style="width: 100%; padding: 8px; margin-top: 5px; border: 1px solid #ddd; border-radius: 4px;">
                <option value="Credit Card">Credit Card</option>
                <option value="Debit Card">Debit Card</option>
                <option value="Cash">Cash</option>
            </select>
        </div>

        <div style="margin-bottom: 15px;">
            <button type="submit" style="padding: 10px 20px; background-color: #007bff; color: white; border: none; border-radius: 4px; cursor: pointer; margin-right: 10px;">Place Order</button>
            <a asp-page="/cart" style="padding: 10px 20px; background-color: #6c757d; color: white; text-decoration: none; border-radius: 4px; display: inline-block;">Back to Cart</a>
        </div>
    </form>
</div>

