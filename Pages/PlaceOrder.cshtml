@page
@model StyleSphere.Pages.PlaceOrderModel
@{
    ViewData["Title"] = "Checkout - StyleSphere";
    Layout = "_CustomerLayout";
    
    var subtotal = ViewData["Subtotal"] as decimal? ?? 0;
    var tax = ViewData["Tax"] as decimal? ?? 0;
    var total = ViewData["Total"] as decimal? ?? 0;
}

<div class="container py-4 pb-5">
    <div class="d-flex justify-content-between align-items-baseline mb-4 pb-2 border-bottom">
        <div>
            <h1 class="h3 fw-bold mb-1 text-uppercase letter-spacing-1">Checkout</h1>
            <span class="text-secondary small">Finalize order details and delivery preference</span>
        </div>
        <a asp-page="/cart" class="small fw-semibold text-dark text-uppercase letter-spacing-1">
            &larr; Return to Bag
        </a>
    </div>

    <div class="row g-5">
        <!-- Form -->
        <div class="col-lg-7">
            <div class="clean-card mb-4">
                <form method="post">
                    <div class="mb-4 pb-3 border-bottom">
                        <div class="form-label mb-2">1. Delivery Destination</div>
                        <div class="p-3 bg-light border small text-secondary">
                            Standard shipping to account destination address. Estimated delivery within 3-5 business days.
                        </div>
                    </div>

                    <div class="mb-4">
                        <div class="form-label mb-2">2. Payment Method</div>
                        <select name="paymentMethod" id="paymentMethod" class="form-select rounded-0" required>
                            <option value="Credit Card">Credit Card (Visa, Mastercard, Amex)</option>
                            <option value="Debit Card">Debit Card</option>
                            <option value="Cash">Cash on Delivery</option>
                        </select>
                    </div>

                    <div class="d-flex gap-3 pt-3 border-top">
                        <button type="submit" class="btn btn-solid flex-grow-1 py-3">
                            Confirm and Place Order
                        </button>
                        <a asp-page="/cart" class="btn btn-outline-minimal py-3 px-4">
                            Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>

        <!-- Summary -->
        <div class="col-lg-5">
            <div class="summary-box-minimal">
                <h4>Order Summary</h4>
                <div class="summary-line">
                    <span>Items Subtotal</span>
                    <span>$@subtotal.ToString("F2")</span>
                </div>
                <div class="summary-line">
                    <span>Estimated Tax (14%)</span>
                    <span>$@tax.ToString("F2")</span>
                </div>
                <div class="summary-line">
                    <span>Shipping</span>
                    <span class="text-dark fw-bold">FREE</span>
                </div>
                <div class="summary-line total">
                    <span>Total</span>
                    <span>$@total.ToString("F2")</span>
                </div>

                <div class="mt-4 pt-3 border-top small text-secondary">
                    All orders are subject to our standard terms and free 30-day return policy.
                </div>
            </div>
        </div>
    </div>
</div>
