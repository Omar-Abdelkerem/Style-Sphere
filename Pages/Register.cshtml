@page
@model StyleSphere.Pages.RegisterModel
@{
    ViewData["Title"] = "Create Account - StyleSphere";
    ViewData["MetaDescription"] = "Create a StyleSphere account for faster checkout, saved bags, and order tracking.";
    Layout = "_CustomerLayout";
}

<div class="container py-5">
    <div style="max-width: 460px; margin: 40px auto;">
        <div class="clean-card">
            <h1 class="h4 fw-bold text-center mb-1 text-uppercase letter-spacing-1">Create Account</h1>
            <p class="text-secondary small text-center mb-4">Register for faster checkout and order tracking.</p>

            @if (ViewData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger rounded-0 py-2 px-3 small mb-3" role="alert">
                    @ViewData["ErrorMessage"]
                </div>
            }

            <form method="post">
                <div class="mb-3">
                    <label for="name" class="form-label">Full Name</label>
                    <input type="text" name="name" id="name" value="@ViewData["EnteredName"]" class="form-control" placeholder="Full name" maxlength="100" autocomplete="name" required />
                </div>

                <div class="mb-3">
                    <label for="email" class="form-label">Email Address</label>
                    <input type="email" name="email" id="email" value="@ViewData["EnteredEmail"]" class="form-control" placeholder="Email address" maxlength="100" autocomplete="email" required />
                </div>

                <div class="mb-3">
                    <label for="phone" class="form-label">Phone Contact (Optional)</label>
                    <input type="tel" name="phone" id="phone" value="@ViewData["EnteredPhone"]" class="form-control" placeholder="Phone number" maxlength="20" autocomplete="tel" />
                </div>

                <div class="mb-3">
                    <label for="password" class="form-label">Password (min 6 characters)</label>
                    <input type="password" name="password" id="password" class="form-control" placeholder="Password" minlength="6" maxlength="255" autocomplete="new-password" required />
                </div>

                <div class="mb-4">
                    <label for="confirmPassword" class="form-label">Confirm Password</label>
                    <input type="password" name="confirmPassword" id="confirmPassword" class="form-control" placeholder="Confirm password" minlength="6" maxlength="255" autocomplete="new-password" required />
                </div>

                <button type="submit" class="btn btn-solid w-100 py-3 mb-3">
                    Register Account
                </button>
            </form>

            <div class="text-center small text-secondary">
                Already registered? <a asp-page="/login" class="text-dark fw-bold">Sign In</a>
            </div>
        </div>
    </div>
</div>
