@page
@model StyleSphere.Pages.RegisterModel
@{
    ViewData["Title"] = "Register - StyleSphere";
    Layout = "_CustomerLayout";
}

<div class="auth-container">
    <h1>Create Account</h1>
    
    @* Display error message if registration failed *@
    @if (ViewData["ErrorMessage"] != null)
    {
        <div style="background-color: #f8d7da; color: #721c24; padding: 15px; margin: 10px 0; border: 1px solid #f5c6cb; border-radius: 4px;">
            @ViewData["ErrorMessage"]
        </div>
    }
    
    @* Registration form *@
    @* When submitted, it will call OnPost method with all form fields *@
    <form method="post">
        @* Full Name input field *@
        <div style="margin-bottom: 15px;">
            <label for="name">Full Name</label><br />
            <input type="text" name="name" id="name" placeholder="Enter your full name" required style="width: 100%; padding: 8px; margin-top: 5px; border: 1px solid #ddd; border-radius: 4px;" />
        </div>

        @* Email input field *@
        <div style="margin-bottom: 15px;">
            <label for="email">Email</label><br />
            <input type="email" name="email" id="email" placeholder="Enter your email" required style="width: 100%; padding: 8px; margin-top: 5px; border: 1px solid #ddd; border-radius: 4px;" />
        </div>

        @* Phone input field (optional) *@
        <div style="margin-bottom: 15px;">
            <label for="phone">Phone Number (Optional)</label><br />
            <input type="tel" name="phone" id="phone" placeholder="Enter your phone number" style="width: 100%; padding: 8px; margin-top: 5px; border: 1px solid #ddd; border-radius: 4px;" />
        </div>

        @* Password input field *@
        <div style="margin-bottom: 15px;">
            <label for="password">Password (minimum 6 characters)</label><br />
            <input type="password" name="password" id="password" placeholder="Create a password" required style="width: 100%; padding: 8px; margin-top: 5px; border: 1px solid #ddd; border-radius: 4px;" />
        </div>

        @* Confirm Password input field *@
        <div style="margin-bottom: 15px;">
            <label for="confirmPassword">Confirm Password</label><br />
            <input type="password" name="confirmPassword" id="confirmPassword" placeholder="Confirm your password" required style="width: 100%; padding: 8px; margin-top: 5px; border: 1px solid #ddd; border-radius: 4px;" />
        </div>

        @* Submit button *@
        <button type="submit" style="width: 100%; padding: 10px; background-color: #007bff; color: white; border: none; border-radius: 4px; cursor: pointer;">Sign Up</button>
    </form>
    
    @* Link to login page *@
    <div class="auth-switch">
        Already have an account? <a asp-page="/login">Login</a>
    </div>
</div>

