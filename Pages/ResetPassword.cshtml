@page
@model StyleSphere.Pages.ResetPasswordModel
@{
    ViewData["Title"] = "Set New Password - StyleSphere";
    ViewData["MetaDescription"] = "Choose a new password for your StyleSphere account.";
    Layout = "_CustomerLayout";
    bool tokenInvalid = ViewData["TokenInvalid"] as bool? ?? false;
    string? token = ViewData["Token"] as string;
}

<div class="container py-5">
    <div style="max-width: 440px; margin: 40px auto;">
        <div class="clean-card">
            <h1 class="h4 fw-bold text-center mb-1 text-uppercase letter-spacing-1">Set New Password</h1>
            <p class="text-secondary small text-center mb-4">Choose a strong new password for your account.</p>

            @if (ViewData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger rounded-0 py-2 px-3 small mb-3" role="alert">
                    @ViewData["ErrorMessage"]
                </div>
            }

            @if (tokenInvalid)
            {
                <div class="text-center mt-3">
                    <a asp-page="/ForgotPassword" class="btn btn-solid w-100 py-3">
                        Request New Reset Link
                    </a>
                </div>
            }
            else
            {
                <form method="post">
                    <input type="hidden" name="token" value="@token" />

                    <div class="mb-3">
                        <label for="newPassword" class="form-label">New Password (min 6 characters)</label>
                        <input type="password" name="newPassword" id="newPassword" class="form-control" placeholder="New password" minlength="6" maxlength="255" required />
                    </div>

                    <div class="mb-4">
                        <label for="confirmPassword" class="form-label">Confirm New Password</label>
                        <input type="password" name="confirmPassword" id="confirmPassword" class="form-control" placeholder="Repeat new password" minlength="6" maxlength="255" required />
                    </div>

                    <button type="submit" class="btn btn-solid w-100 py-3 mb-3">
                        Update Password
                    </button>
                </form>
            }

            <div class="text-center small text-secondary mt-2">
                <a asp-page="/login" class="text-dark fw-bold">Return to Sign In</a>
            </div>
        </div>
    </div>
</div>
