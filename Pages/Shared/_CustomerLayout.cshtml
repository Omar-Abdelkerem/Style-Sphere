@{
    var pageTitle = ViewData["Title"] as string ?? "StyleSphere - Contemporary Fashion & Essentials";
    var metaDesc = ViewData["MetaDescription"] as string ?? "StyleSphere curated ready-to-wear, footwear, and accessories. Designed with an emphasis on craftsmanship, understated silhouette, and enduring materials.";
    var ogImage = ViewData["OgImage"] as string ?? "/images/products/blazer-wool.jpg";
    var userId = Context.Session.GetString("UserId");
    var userName = Context.Session.GetString("UserName");
    var userRole = Context.Session.GetString("UserRole");
    var cartCount = Context.Items["CartItemCount"] as int? ?? 0;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@pageTitle</title>
    <meta name="description" content="@metaDesc" />

    <!-- Open Graph / Social Preview Metadata -->
    <meta property="og:site_name" content="StyleSphere" />
    <meta property="og:title" content="@pageTitle" />
    <meta property="og:description" content="@metaDesc" />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="@ogImage" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@pageTitle" />
    <meta name="twitter:description" content="@metaDesc" />

    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!-- Clean Minimalist Style -->
    <link rel="stylesheet" href="~/css/customer.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
    <!-- Keyboard Accessibility Skip Link -->
    <a href="#main-content" class="visually-hidden-focusable bg-dark text-white px-3 py-2 position-absolute top-0 start-0" style="z-index: 2000;">
        Skip to main content
    </a>

    <!-- Clean Top Announcement -->
    <div class="top-announcement-bar text-center">
        <div class="container d-flex justify-content-between align-items-center">
            <span>Complimentary shipping on orders over $50</span>
            <div class="d-none d-md-flex gap-4">
                <span>Free 30-Day Returns</span>
                <span>Authentic Quality Guaranteed</span>
            </div>
        </div>
    </div>

    <!-- Main Navigation Header -->
    <header class="site-header">
        <div class="container py-3">
            <div class="row align-items-center">
                <!-- Brand Logo & Mobile Menu Toggle -->
                <div class="col-lg-3 col-6 d-flex align-items-center gap-2">
                    <button class="btn btn-sm border-0 p-1 d-lg-none" type="button" data-bs-toggle="collapse" data-bs-target="#mobileNavDrawer" aria-controls="mobileNavDrawer" aria-expanded="false" aria-label="Toggle navigation menu">
                        <i class="bi bi-list fs-4"></i>
                    </button>
                    <a asp-page="/Index" class="brand-text text-decoration-none">
                        STYLESPHERE
                    </a>
                </div>

                <!-- Desktop Navigation Links -->
                <div class="col-lg-6 d-none d-lg-block text-center">
                    <nav class="d-inline-flex gap-1" aria-label="Main navigation">
                        <a asp-page="/Index" class="nav-link @(ViewContext.RouteData.Values["page"]?.ToString() == "/Index" ? "active" : "")">Home</a>
                        <a asp-page="/Products" class="nav-link @(ViewContext.RouteData.Values["page"]?.ToString() == "/Products" && ViewContext.HttpContext.Request.Query["categoryId"].Count == 0 ? "active" : "")">All</a>
                        <a asp-page="/Products" asp-route-categoryId="1" class="nav-link @(ViewContext.HttpContext.Request.Query["categoryId"] == "1" ? "active" : "")">Men</a>
                        <a asp-page="/Products" asp-route-categoryId="2" class="nav-link @(ViewContext.HttpContext.Request.Query["categoryId"] == "2" ? "active" : "")">Women</a>
                        <a asp-page="/Products" asp-route-categoryId="3" class="nav-link @(ViewContext.HttpContext.Request.Query["categoryId"] == "3" ? "active" : "")">Shoes</a>
                        <a asp-page="/Products" asp-route-categoryId="4" class="nav-link @(ViewContext.HttpContext.Request.Query["categoryId"] == "4" ? "active" : "")">Accessories</a>
                    </nav>
                </div>

                <!-- Search and Account Actions -->
                <div class="col-lg-3 col-6 d-flex align-items-center justify-content-end gap-3">
                    <!-- Desktop Search Input -->
                    <form method="get" asp-page="/Products" class="d-none d-md-block" role="search">
                        <input type="search" name="search" class="search-input" placeholder="Search..." aria-label="Search catalog" maxlength="100" style="width: 140px;" />
                    </form>

                    @if (!string.IsNullOrEmpty(userId))
                    {
                        <div class="dropdown">
                            <a href="#" class="nav-link dropdown-toggle text-dark p-0" id="userMenu" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                @userName
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end border rounded-0 shadow-sm py-2" aria-labelledby="userMenu">
                                <li><a class="dropdown-item small py-2" asp-page="/Orders">Order History</a></li>
                                <li><a class="dropdown-item small py-2" asp-page="/ChangePassword">Password Settings</a></li>
                                @if (userRole == "Admin")
                                {
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item small py-2 fw-bold text-dark" asp-page="/Admin/Index">Admin Console</a></li>
                                }
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <form method="post" asp-page="/Logout" class="m-0">
                                        <button type="submit" class="dropdown-item small py-2 text-danger">Sign Out</button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <a asp-page="/login" class="nav-link p-0">Sign In</a>
                    }

                    <!-- Bag Button with Live Item Count Badge -->
                    <a asp-page="/cart" class="btn-icon-link" title="Shopping Bag" aria-label="Shopping Bag (@cartCount items)">
                        <i class="bi bi-bag" aria-hidden="true"></i>
                        @if (cartCount > 0)
                        {
                            <span class="cart-count-badge">@cartCount</span>
                        }
                    </a>
                </div>
            </div>

            <!-- Collapsible Mobile & Tablet Navigation Drawer -->
            <div class="collapse d-lg-none pt-3 mt-2 border-top" id="mobileNavDrawer">
                <form method="get" asp-page="/Products" class="mb-3 d-md-none" role="search">
                    <div class="d-flex gap-2">
                        <input type="search" name="search" class="search-input flex-grow-1" placeholder="Search catalog..." aria-label="Search catalog" maxlength="100" />
                        <button type="submit" class="btn btn-sm btn-solid">Search</button>
                    </div>
                </form>
                <nav class="d-flex flex-column gap-1" aria-label="Mobile navigation">
                    <a asp-page="/Index" class="nav-link px-0">Home</a>
                    <a asp-page="/Products" class="nav-link px-0">All Pieces</a>
                    <a asp-page="/Products" asp-route-categoryId="1" class="nav-link px-0">Men</a>
                    <a asp-page="/Products" asp-route-categoryId="2" class="nav-link px-0">Women</a>
                    <a asp-page="/Products" asp-route-categoryId="3" class="nav-link px-0">Shoes</a>
                    <a asp-page="/Products" asp-route-categoryId="4" class="nav-link px-0">Accessories</a>
                </nav>
            </div>
        </div>
    </header>

    <!-- Main Container -->
    <main id="main-content" class="flex-grow-1">
        <div class="container my-2">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-dark border-0 rounded-0 py-2 px-3 small my-3" role="alert">
                    @TempData["SuccessMessage"]
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger border-0 rounded-0 py-2 px-3 small my-3" role="alert">
                    @TempData["ErrorMessage"]
                </div>
            }
        </div>

        @RenderBody()
    </main>

    <!-- Clean Editorial Footer -->
    <footer class="site-footer-minimal mt-auto">
        <div class="container pb-5">
            <div class="row g-4">
                <div class="col-lg-3 col-md-6">
                    <div class="footer-col-title">STYLESPHERE</div>
                    <p class="text-secondary small leading-relaxed">
                        Curated ready-to-wear, footwear, and accessories. Designed with an emphasis on craftsmanship, understated silhouette, and enduring materials.
                    </p>
                </div>

                <div class="col-lg-3 col-6">
                    <div class="footer-col-title">Collections</div>
                    <ul class="footer-menu">
                        <li><a asp-page="/Products" asp-route-categoryId="1">Men's Wardrobe</a></li>
                        <li><a asp-page="/Products" asp-route-categoryId="2">Women's Collection</a></li>
                        <li><a asp-page="/Products" asp-route-categoryId="3">Footwear</a></li>
                        <li><a asp-page="/Products" asp-route-categoryId="4">Accessories</a></li>
                    </ul>
                </div>

                <div class="col-lg-3 col-6">
                    <div class="footer-col-title">Customer Care</div>
                    <ul class="footer-menu">
                        <li><a asp-page="/Orders">Track Order</a></li>
                        <li><a asp-page="/Policies" asp-fragment="shipping">Shipping Policy</a></li>
                        <li><a asp-page="/Policies" asp-fragment="returns">Returns &amp; Exchanges</a></li>
                        <li><a asp-page="/ChangePassword">Account Settings</a></li>
                    </ul>
                </div>

                <div class="col-lg-3 col-md-6">
                    <div class="footer-col-title">Newsletter</div>
                    <p class="small text-secondary mb-3">Sign up for editorial previews and new arrival notices.</p>
                    <form id="newsletter-form" class="d-flex gap-2">
                        <input type="email" id="newsletter-email" class="form-control form-control-sm rounded-0 border" placeholder="Email address" aria-label="Newsletter email address" required />
                        <button type="submit" class="btn btn-sm btn-solid">Join</button>
                    </form>
                    <div id="newsletter-status" class="small text-dark fw-semibold mt-2 d-none" role="status"></div>
                </div>
            </div>
        </div>

        <div class="border-top py-3">
            <div class="container d-flex flex-column flex-sm-row justify-content-between align-items-center small text-secondary">
                <span>&copy; 2026 StyleSphere. All rights reserved.</span>
                <div class="d-flex gap-4 mt-2 mt-sm-0">
                    <a asp-page="/Policies" asp-fragment="privacy" class="text-secondary">Privacy Policy</a>
                    <a asp-page="/Policies" asp-fragment="terms" class="text-secondary">Terms of Service</a>
                </div>
            </div>
        </div>
    </footer>

    <!-- Bootstrap 5 Bundle JS -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
