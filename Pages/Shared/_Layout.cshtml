<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - StyleSphere</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        /* Simple plain HTML styles - no Bootstrap */
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            padding: 0;
        }
        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 20px;
        }
        nav {
            background-color: #f8f9fa;
            padding: 10px 20px;
            border-bottom: 1px solid #ddd;
        }
        nav a {
            text-decoration: none;
            color: #333;
            margin-right: 20px;
        }
        nav a:hover {
            color: #007bff;
        }
        footer {
            border-top: 1px solid #ddd;
            padding: 20px;
            text-align: center;
            margin-top: 40px;
        }
    </style>
</head>
<body>
    <header>
        <nav>
            <a asp-page="/Index">StyleSphere</a>
            <a asp-page="/Index">Home</a>
            <a asp-page="/Products">Products</a>
            <a asp-page="/Admin/Index">Admin</a>
        </nav>
    </header>
    <div class="container">
        <main>
            @RenderBody()
        </main>
    </div>

    <footer>
        <p>&copy; 2025 - StyleSphere - <a asp-page="/Privacy">Privacy</a></p>
    </footer>
</body>
</html>