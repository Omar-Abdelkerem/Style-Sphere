@page
@model StyleSphere.Pages.cartModel
@{
    ViewData["Title"] = "Shopping Bag - StyleSphere";
    ViewData["MetaDescription"] = "Review your selected StyleSphere garments and proceed to checkout.";
    Layout = "_CustomerLayout";
    
    var cart = ViewData["Cart"] as StyleSphere.Models.Cart;
    var subtotal = ViewData["Subtotal"] as decimal? ?? 0;
    var tax = ViewData["Tax"] as decimal? ?? 0;
    var total = ViewData["Total"] as decimal? ?? 0;
}

<div class="container py-4 pb-5">
    <div class="d-flex flex-wrap justify-content-between align-items-baseline gap-2 mb-4 pb-2 border-bottom">
        <div>
            <h1 class="h3 fw-bold mb-1 text-uppercase letter-spacing-1">Shopping Bag</h1>
            <span class="text-secondary small">Review chosen items before checkout</span>
        </div>
        <a asp-page="/Products" class="small fw-semibold text-dark text-uppercase letter-spacing-1">
            Continue Shopping &rarr;
        </a>
    </div>

    @if (cart != null && cart.CartItems != null && cart.CartItems.Count > 0)
    {
        <div class="row g-5">
            <!-- Left Side: Items Table -->
            <div class="col-lg-8">
                <div class="table-responsive">
                    <table class="table-minimal mb-4">
                        <thead>
                            <tr>
                                <th style="min-width: 240px;">Item</th>
                                <th>Price</th>
                                <th style="min-width: 140px;">Quantity</th>
                                <th>Total</th>
                                <th class="text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in cart.CartItems)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center gap-3">
                                            <div style="width: 60px; height: 80px; overflow: hidden; background: #f4f4f4; border: 1px solid var(--border);" class="flex-shrink-0">
                                                @if (!string.IsNullOrEmpty(item.Product?.ImageName))
                                                {
                                                    <img src="~/images/products/@item.Product.ImageName" alt="@item.Product.Name" width="60" height="80" style="width: 100%; height: 100%; object-fit: cover;" />
                                                }
                                                else
                                                {
                                                    <div class="d-flex align-items-center justify-content-center h-100 text-secondary small">No photo</div>
                                                }
                                            </div>
                                            <div>
                                                <a asp-page="/details" asp-route-id="@item.ProductID" class="fw-bold text-dark text-decoration-none d-block small">
                                                    @item.Product?.Name
                                                </a>
                                                <span class="text-secondary" style="font-size: 0.75rem;">@(item.Product?.Category?.Name ?? "Apparel")</span>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="fw-semibold">
                                        $@(item.Product?.Price.ToString("F2") ?? "0.00")
                                    </td>
                                    <td>
                                        <form method="post" asp-page-handler="UpdateQuantity" class="d-flex align-items-center gap-2">
                                            <input type="hidden" name="productId" value="@item.ProductID" />
                                            <input type="number" name="quantity" value="@item.Quantity" min="1" max="@(item.Product?.Stock ?? 99)" 
                                                   aria-label="Quantity for @(item.Product?.Name ?? "item")"
                                                   class="form-control form-control-sm text-center rounded-0 shadow-none" style="width: 60px;" />
                                            <button type="submit" class="btn btn-sm btn-outline-minimal py-1 px-2" title="Update quantity">
                                                Update
                                            </button>
                                        </form>
                                    </td>
                                    <td class="fw-bold">
                                        $@(((item.Product?.Price ?? 0) * item.Quantity).ToString("F2"))
                                    </td>
                                    <td class="text-end">
                                        <form method="post" asp-page-handler="Remove" class="m-0">
                                            <input type="hidden" name="productId" value="@item.ProductID" />
                                            <button type="submit" class="btn btn-sm btn-link text-danger text-decoration-none p-0 small">
                                                Remove
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="p-3 bg-light border small text-secondary">
                    <strong>Shipping Policy:</strong> Complimentary domestic express delivery automatically applied to this order.
                </div>
            </div>

            <!-- Right Side: Order Summary -->
            <div class="col-lg-4">
                <div class="summary-box-minimal">
                    <h2 class="h6 fw-bold text-uppercase letter-spacing-1 mb-3 pb-2 border-bottom">Order Summary</h2>
                    <div class="summary-line">
                        <span>Subtotal</span>
                        <span>$@subtotal.ToString("F2")</span>
                    </div>
                    <div class="summary-line">
                        <span>Estimated Tax (14%)</span>
                        <span>$@tax.ToString("F2")</span>
                    </div>
                    <div class="summary-line">
                        <span>Shipping</span>
                        <span class="text-dark fw-bold">FREE</span>
                    </div>
                    <div class="summary-line total">
                        <span>Total</span>
                        <span>$@total.ToString("F2")</span>
                    </div>

                    <div class="mt-4">
                        <a asp-page="/PlaceOrder" class="btn btn-solid w-100 py-3 text-center d-block">
                            Proceed to Checkout
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="py-5 text-center text-secondary border my-4">
            <h2 class="h4 fw-bold mb-2">Your Bag is Empty</h2>
            <p class="small mb-4">Discover our curated wardrobe essentials and place your first order.</p>
            <a asp-page="/Products" class="btn btn-sm btn-solid">
                Explore Catalog
            </a>
        </div>
    }
</div>
